<Window x:Class="Wms.Desktop.InboundSessionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Wms.Desktop.Converters"
        mc:Ignorable="d"
        Title="Inbound Session Details"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
    </Window.Resources>
    <Grid Background="#F3F4F6" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Inbound Session"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding Session.Title}"
                       FontSize="14"
                       Foreground="#4B5563" />
        </StackPanel>

        <!-- Header fields -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="ASN"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Session.AdvanceShippingNotice}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Transfer Order (Optional)"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Session.TransferOrder, TargetNullValue='Not assigned'}"
                               FontSize="14"
                               Foreground="#111827" />
                    <TextBlock Text="Used for store allocation during sorting"
                               FontSize="10"
                               Foreground="#6B7280"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Dock"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Session.Dock}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Session.Status}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Started By"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Session.StartedBy}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Started On"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Session.StartedOn, StringFormat=yyyy-MM-dd HH:mm}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Unload Lines -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Unload Lines"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding UnloadLines}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          MouseDoubleClick="UnloadLinesDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Unit Type"
                                            Binding="{Binding UnitType}"
                                            Width="120" />
                        <DataGridTextColumn Header="Unit ID"
                                            Binding="{Binding UnitId}"
                                            Width="200" />
                        <DataGridTextColumn Header="Scanned By"
                                            Binding="{Binding ScannedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Scanned On"
                                            Binding="{Binding ScannedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Receive Lines -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Receive Lines"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="+ Add Line"
                                Command="{Binding AddReceiveLineCommand}"
                                Padding="8,4"
                                Margin="0,0,4,0"
                                Background="#10B981"
                                Foreground="White"
                                BorderThickness="0" />
                        <Button Content="Remove"
                                Command="{Binding RemoveReceiveLineCommand}"
                                Padding="8,4"
                                Background="#EF4444"
                                Foreground="White"
                                BorderThickness="0" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ReceiveLines}"
                          SelectedItem="{Binding SelectedReceiveLine}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Carton ID"
                                            Binding="{Binding CartonId, UpdateSourceTrigger=PropertyChanged}"
                                            Width="140"
                                            IsReadOnly="False" />
                        <DataGridTextColumn Header="Item Code"
                                            Binding="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"
                                            Width="160"
                                            IsReadOnly="False" />
                        <DataGridTextColumn Header="Expected Qty"
                                            Binding="{Binding ExpectedQty}"
                                            Width="110"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Received Qty" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="-"
                                                Command="{Binding DataContext.DecrementReceivedQtyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Width="30"
                                                Height="24"
                                                Padding="0"
                                                Margin="0,0,4,0"
                                                Background="#EF4444"
                                                Foreground="White"
                                                BorderThickness="0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ReceivedQty, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Right"
                                                 Padding="4,2"
                                                 Margin="0" />
                                        <Button Grid.Column="2"
                                                Content="+"
                                                Command="{Binding DataContext.IncrementReceivedQtyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Width="30"
                                                Height="24"
                                                Padding="0"
                                                Margin="4,0,0,0"
                                                Background="#10B981"
                                                Foreground="White"
                                                BorderThickness="0" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Condition" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Condition}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding Condition, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="Good" />
                                        <ComboBoxItem Content="Damaged" />
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Remarks"
                                            Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"
                                            IsReadOnly="False" />
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShort}" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOver}" Value="True">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Quick Actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Quick Actions: "
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="#6B7280" />
                    <Button Content="+1 Qty"
                            Command="{Binding IncrementReceivedQtyCommand}"
                            Padding="6,2"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding SelectedReceiveLine, Converter={StaticResource IsNotNullConverter}}" />
                    <Button Content="-1 Qty"
                            Command="{Binding DecrementReceivedQtyCommand}"
                            Padding="6,2"
                            IsEnabled="{Binding SelectedReceiveLine, Converter={StaticResource IsNotNullConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Totals + Close -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalUnloads, StringFormat=Total Unloads: {0}}"
                       Margin="0,0,16,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalExpectedQty, StringFormat=Total Expected: {0}}"
                       Margin="0,0,16,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#6B7280"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalReceivedQty, StringFormat=Total Received: {0}}"
                       Margin="0,0,24,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <Button Content="Close"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

