<Window x:Class="Wms.Desktop.Windows.UserPasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Wms.Desktop.ViewModels"
        xmlns:converters="clr-namespace:Wms.Desktop.Converters"
        mc:Ignorable="d"
        Title="Change User Password"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Window.DataContext>
        <viewModels:UserPasswordChangeViewModel />
    </Window.DataContext>
    
    <Grid Background="#F3F4F6" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Change Password"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding UserInfo, StringFormat='User: {0}'}"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="20"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <StackPanel>
                <!-- Current Password (if changing own password) -->
                <StackPanel Margin="0,0,0,16" Visibility="{Binding ShowCurrentPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Current Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,4" />
                    <PasswordBox x:Name="CurrentPasswordBox"
                                 PasswordChanged="CurrentPasswordBox_PasswordChanged"
                                 FontSize="14"
                                 Padding="8" />
                </StackPanel>

                <!-- New Password -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="New Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,4" />
                    <PasswordBox x:Name="NewPasswordBox"
                                 PasswordChanged="NewPasswordBox_PasswordChanged"
                                 FontSize="14"
                                 Padding="8" />
                    <TextBlock Text="Password must be at least 6 characters"
                               FontSize="11"
                               Foreground="#6B7280"
                               Margin="4,4,0,0" />
                </StackPanel>

                <!-- Confirm Password -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Confirm New Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,0,0,4" />
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                 FontSize="14"
                                 Padding="8" />
                    <TextBlock Text="{Binding PasswordMatchMessage}"
                               FontSize="11"
                               Foreground="{Binding PasswordMatchColor}"
                               Margin="4,4,0,0"
                               Visibility="{Binding ShowPasswordMatch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="#DC2626"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Style="{StaticResource {x:Type Button}}"
                    Background="#F3F4F6"
                    Foreground="#374151"
                    BorderBrush="#D1D5DB" />
            <Button Content="Change Password"
                    Width="140"
                    Height="36"
                    Command="{Binding ChangePasswordCommand}"
                    IsEnabled="{Binding CanChangePassword}"
                    Style="{StaticResource {x:Type Button}}"
                    Background="#2563EB"
                    Foreground="White"
                    BorderBrush="#2563EB" />
        </StackPanel>
    </Grid>
</Window>

