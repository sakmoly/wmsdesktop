<Window x:Class="Wms.Desktop.TransferOrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Transfer Order Details"
        Height="420" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F3F4F6" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Transfer Order"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding TransferOrder.Title}"
                       FontSize="14"
                       Foreground="#4B5563" />
        </StackPanel>

        <!-- Header fields -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="ASN"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferOrder.AdvanceShippingNotice}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="From Warehouse"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferOrder.FromWarehouse}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Prepared By"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferOrder.PreparedBy}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferOrder.Status}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="WMS Export Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferOrder.WmsExportStatus, FallbackValue=Pending}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Required Date"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferOrder.RequiredDate, StringFormat=d}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Total Allocated Qty"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferOrder.TotalAllocatedQty}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Picking / item lines -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Item Lines"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TransferOrder.Items}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Store"
                                            Binding="{Binding Store}"
                                            Width="160" />
                        <DataGridTextColumn Header="Item Code"
                                            Binding="{Binding ItemCode}"
                                            Width="180" />
                        <DataGridTextColumn Header="Allocated Qty"
                                            Binding="{Binding AllocatedQty}"
                                            Width="120" />
                        <DataGridTextColumn Header="Sorted Qty"
                                            Binding="{Binding SortedQty}"
                                            Width="120" />
                        <DataGridTextColumn Header="Packed Qty"
                                            Binding="{Binding PackedQty}"
                                            Width="120" />
                        <DataGridTextColumn Header="Pending Qty"
                                            Binding="{Binding PendingQty}"
                                            Width="120" />
                        <DataGridTextColumn Header="Remarks"
                                            Binding="{Binding Remarks}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Totals + Close -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalLines, StringFormat=Lines: {0}}"
                       Margin="0,0,16,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalQty, StringFormat=Total Qty: {0}}"
                       Margin="0,0,24,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <Button Content="Close"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>


