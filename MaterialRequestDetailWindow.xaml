<Window x:Class="Wms.Desktop.MaterialRequestDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Wms.Desktop.Converters"
        mc:Ignorable="d"
        Title="Material Request Details"
        Height="500" Width="1200"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Background="#F3F4F6" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Material Request"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding MaterialRequest.Title}"
                       FontSize="14"
                       Foreground="#4B5563" />
        </StackPanel>

        <!-- Header fields -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="From Warehouse"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding MaterialRequest.FromWarehouse}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="To Showroom"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding MaterialRequest.ToShowroom}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Requested By"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding MaterialRequest.RequestedBy}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding MaterialRequest.Status}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Requested Date"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding MaterialRequest.RequestedDate, StringFormat=d}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Required Date"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding MaterialRequest.RequiredDate, StringFormat=d}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Item lines -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Item Lines"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0"
                              x:Name="ItemLinesGrid"
                              ItemsSource="{Binding MaterialRequest.Items}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              SelectionChanged="ItemLinesGrid_SelectionChanged"
                              Margin="0,0,8,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Code"
                                                Binding="{Binding ItemCode}"
                                                Width="200" />
                            <DataGridTextColumn Header="Requested Qty"
                                                Binding="{Binding RequestedQty, StringFormat=N2}"
                                                Width="120" />
                            <DataGridTextColumn Header="Picked Qty"
                                                Binding="{Binding PickedQty, StringFormat=N2}"
                                                Width="120" />
                            <DataGridTextColumn Header="Pending Qty"
                                                Binding="{Binding PendingQty, StringFormat=N2}"
                                                Width="120" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Available Cartons Panel (shown when carton mode and item selected) -->
                    <Border Grid.Column="1"
                            x:Name="AvailableCartonsPanel"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Visibility="{Binding IsCartonLevelMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Available Cartons"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,8"
                                       Foreground="#111827" />
                            
                            <TextBlock x:Name="SelectedItemText"
                                       Text="Select an item to see available cartons"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="SourceBinPrompt"
                                       Text="Source Bin:"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,4"
                                       Visibility="Collapsed" />
                            <TextBox x:Name="SourceBinTextBox"
                                    Margin="0,0,0,8"
                                    Padding="4"
                                    Visibility="Collapsed"
                                    TextChanged="SourceBinTextBox_TextChanged" />

                            <DataGrid x:Name="AvailableCartonsGrid"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      MaxHeight="300"
                                      Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Carton ID"
                                                        Binding="{Binding CartonId}"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Available Qty"
                                                        Binding="{Binding AvailableQty, StringFormat=N2}"
                                                        Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="NoCartonsText"
                                       Text="No cartons available for this item in the selected bin"
                                       FontSize="11"
                                       Foreground="#EF4444"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Totals + Close -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalLines, StringFormat=Lines: {0}}"
                       Margin="0,0,16,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalRequestedQty, StringFormat=Total Requested: {0:N2}}"
                       Margin="0,0,16,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalPickedQty, StringFormat=Total Picked: {0:N2}}"
                       Margin="0,0,24,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <Button Content="Close"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

