<UserControl x:Class="Wms.Desktop.Views.CycleCountTaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Wms.Desktop.ViewModels"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <viewModels:CycleCountTaskListViewModel />
    </UserControl.DataContext>

    <Grid Background="#F3F4F6" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Cycle Count Tasks"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="Physical inventory counting and discrepancy management"
                       FontSize="12"
                       Foreground="#6B7280" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <DataGrid x:Name="CycleCountTaskGrid"
                      ItemsSource="{Binding CycleCountTasks}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      MouseDoubleClick="CycleCountTaskGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Task Title"
                                        Binding="{Binding Title}"
                                        Width="150" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="120" />
                    <DataGridTextColumn Header="Count Type"
                                        Binding="{Binding CountType}"
                                        Width="120" />
                    <DataGridTextColumn Header="Warehouse"
                                        Binding="{Binding Warehouse}"
                                        Width="130" />
                    <DataGridTextColumn Header="Zone/Bin"
                                        Binding="{Binding Zone}"
                                        Width="150" />
                    <DataGridTextColumn Header="Count Date"
                                        Binding="{Binding CountDate, StringFormat=d}"
                                        Width="120" />
                    <DataGridTextColumn Header="Created By"
                                        Binding="{Binding CreatedBy}"
                                        Width="120" />
                    <DataGridTextColumn Header="Assigned To"
                                        Binding="{Binding AssignedTo}"
                                        Width="120" />
                    <DataGridTextColumn Header="Total Items"
                                        Binding="{Binding TotalItems}"
                                        Width="100" />
                    <DataGridTextColumn Header="Counted Items"
                                        Binding="{Binding CountedItems}"
                                        Width="110" />
                    <DataGridTextColumn Header="With Discrepancy"
                                        Binding="{Binding ItemsWithDiscrepancy}"
                                        Width="130" />
                    <DataGridCheckBoxColumn Header="Freeze Stock"
                                            Binding="{Binding FreezeStock}"
                                            Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

