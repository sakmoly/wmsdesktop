<UserControl x:Class="Wms.Desktop.Views.RoleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Wms.Desktop.ViewModels"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <viewModels:RoleListViewModel />
    </UserControl.DataContext>

    <Grid Background="#F3F4F6" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Roles &amp; Permissions"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="WMS Role + Role Permission (mock data)"
                       FontSize="12"
                       Foreground="#6B7280" />
        </StackPanel>

        <!-- Roles -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Roles"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Roles}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          Height="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Role Name"
                                            Binding="{Binding RoleName}"
                                            Width="*" />
                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive}"
                                                Width="80" />
                        <DataGridCheckBoxColumn Header="Mobile Access"
                                                Binding="{Binding MobileAccess}"
                                                Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Permissions -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Role Permissions"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Permissions}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Permission ID"
                                            Binding="{Binding PermissionId}"
                                            Width="180" />
                        <DataGridTextColumn Header="Role"
                                            Binding="{Binding RoleName}"
                                            Width="150" />
                        <DataGridTextColumn Header="DocType"
                                            Binding="{Binding DocTypeName}"
                                            Width="200" />
                        <DataGridTextColumn Header="Level"
                                            Binding="{Binding PermLevel}"
                                            Width="60" />
                        <DataGridCheckBoxColumn Header="Read"
                                                Binding="{Binding AllowRead}"
                                                Width="60" />
                        <DataGridCheckBoxColumn Header="Write"
                                                Binding="{Binding AllowWrite}"
                                                Width="60" />
                        <DataGridCheckBoxColumn Header="Create"
                                                Binding="{Binding AllowCreate}"
                                                Width="70" />
                        <DataGridCheckBoxColumn Header="Delete"
                                                Binding="{Binding AllowDelete}"
                                                Width="70" />
                        <DataGridCheckBoxColumn Header="Submit"
                                                Binding="{Binding AllowSubmit}"
                                                Width="70" />
                        <DataGridCheckBoxColumn Header="Cancel"
                                                Binding="{Binding AllowCancel}"
                                                Width="70" />
                        <DataGridCheckBoxColumn Header="Amend"
                                                Binding="{Binding AllowAmend}"
                                                Width="70" />
                        <DataGridCheckBoxColumn Header="Import"
                                                Binding="{Binding AllowImport}"
                                                Width="70" />
                        <DataGridCheckBoxColumn Header="Export"
                                                Binding="{Binding AllowExport}"
                                                Width="70" />
                        <DataGridCheckBoxColumn Header="Show In Menu"
                                                Binding="{Binding ShowInMenu}"
                                                Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


