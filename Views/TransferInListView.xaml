<UserControl x:Class="Wms.Desktop.Views.TransferInListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Wms.Desktop.ViewModels"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <viewModels:TransferInListViewModel />
    </UserControl.DataContext>

    <Grid Background="#F3F4F6" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Transfer In (Showroom to Warehouse)"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#111827" />
                    <TextBlock Text="Items transferred from showroom to warehouse (local import + ERPNext sync)"
                               FontSize="12"
                               Foreground="#6B7280" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="12,6"
                        VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <DataGrid x:Name="TransferInGrid"
                      ItemsSource="{Binding TransferIns}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      MouseDoubleClick="TransferInGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Transfer In No."
                                        Binding="{Binding Title}"
                                        Width="140" />
                    <DataGridTextColumn Header="From Showroom"
                                        Binding="{Binding FromShowroom}"
                                        Width="150" />
                    <DataGridTextColumn Header="To Warehouse"
                                        Binding="{Binding ToWarehouse}"
                                        Width="150" />
                    <DataGridTextColumn Header="Transfer Date"
                                        Binding="{Binding TransferDate, StringFormat=d}"
                                        Width="130" />
                    <DataGridTextColumn Header="Expected Arrival"
                                        Binding="{Binding ExpectedArrivalDate, StringFormat=d}"
                                        Width="130" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="120" />
                    <DataGridTextColumn Header="Prepared By"
                                        Binding="{Binding PreparedBy}"
                                        Width="120" />
                    <DataGridTextColumn Header="Total Qty"
                                        Binding="{Binding TotalQty}"
                                        Width="100" />
                    <DataGridTextColumn Header="Items Count"
                                        Binding="{Binding Items.Count}"
                                        Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

