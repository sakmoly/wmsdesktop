<UserControl x:Class="Wms.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Wms.Desktop.ViewModels"
             Background="#F3F4F6">
    <UserControl.DataContext>
        <viewModels:HomeViewModel />
    </UserControl.DataContext>

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Printechs WMS"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="Pull data from ERPNext and push WMS data in one step"
                       FontSize="14"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32" />

            <Button Content="Push &amp; Pull"
                    Command="{Binding PushAndPullCommand}"
                    IsEnabled="{Binding CanRunPushAndPull}"
                    Padding="32,20"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Background="#3B82F6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Text="Pulls: ASNs, Transfer Orders, Material Requests, Transfer In → Then pushes WMS snapshot to ERPNext"
                       FontSize="12"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="400"
                       Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
