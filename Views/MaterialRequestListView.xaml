<UserControl x:Class="Wms.Desktop.Views.MaterialRequestListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Wms.Desktop.ViewModels"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <viewModels:MaterialRequestListViewModel />
    </UserControl.DataContext>

    <Grid Background="#F3F4F6" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Material Requests (Warehouse to Showroom)"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="Items requested by showroom from warehouse"
                       FontSize="12"
                       Foreground="#6B7280" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <DataGrid x:Name="MaterialRequestGrid"
                      ItemsSource="{Binding MaterialRequests}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      MouseDoubleClick="MaterialRequestGrid_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material Request No."
                                        Binding="{Binding Title}"
                                        Width="160" />
                    <DataGridTextColumn Header="From Warehouse"
                                        Binding="{Binding FromWarehouse}"
                                        Width="150" />
                    <DataGridTextColumn Header="To Showroom"
                                        Binding="{Binding ToShowroom}"
                                        Width="150" />
                    <DataGridTextColumn Header="Requested Date"
                                        Binding="{Binding RequestedDate, StringFormat=d}"
                                        Width="130" />
                    <DataGridTextColumn Header="Required Date"
                                        Binding="{Binding RequiredDate, StringFormat=d}"
                                        Width="130" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="120" />
                    <DataGridTextColumn Header="Requested By"
                                        Binding="{Binding RequestedBy}"
                                        Width="120" />
                    <DataGridTextColumn Header="Total Requested Qty"
                                        Binding="{Binding TotalRequestedQty}"
                                        Width="150" />
                    <DataGridTextColumn Header="Total Picked Qty"
                                        Binding="{Binding TotalPickedQty}"
                                        Width="140" />
                    <DataGridTextColumn Header="Items Count"
                                        Binding="{Binding Items.Count}"
                                        Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

