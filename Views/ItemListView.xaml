<UserControl x:Class="Wms.Desktop.Views.ItemListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Wms.Desktop.ViewModels"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <viewModels:ItemListViewModel />
    </UserControl.DataContext>

    <Grid Background="#F3F4F6" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Items"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827" />
                <TextBlock Text="Item master (mock data based on WMS Item DocType)"
                           FontSize="12"
                           Foreground="#6B7280" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="ShowLocationsButton"
                    Content="Show Location Breakdown"
                    Margin="8,0,0,0"
                    Padding="12,6"
                    VerticalAlignment="Bottom"
                    Click="ShowLocationsButton_OnClick" />
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <DataGrid x:Name="ItemsGrid"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionChanged="ItemsGrid_OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code"
                                        Binding="{Binding Code}"
                                        Width="200" />
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="250" />
                    <DataGridTextColumn Header="Item Group"
                                        Binding="{Binding ItemGroup}"
                                        Width="200" />
                    <DataGridTextColumn Header="Brand"
                                        Binding="{Binding Brand}"
                                        Width="150" />
                    <DataGridTextColumn Header="Barcode"
                                        Binding="{Binding Barcode}"
                                        Width="160" />
                    <DataGridTextColumn Header="Default UOM"
                                        Binding="{Binding DefaultUom}"
                                        Width="100" />
                    <DataGridTextColumn Header="Stock Qty"
                                        Binding="{Binding StockQty, StringFormat=N0}"
                                        Width="100" />
                    <DataGridTextColumn Header="Reserved Qty"
                                        Binding="{Binding ReservedQty, StringFormat=N0}"
                                        Width="110" />
                    <DataGridTextColumn Header="Available Qty"
                                        Binding="{Binding AvailableQty, StringFormat=N0}"
                                        Width="110" />
                    <DataGridCheckBoxColumn Header="Maintain Stock"
                                            Binding="{Binding MaintainStock}"
                                            Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>


