<Window x:Class="Wms.Desktop.TransferCartonDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Transfer Carton Details"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F3F4F6" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Transfer Carton Details"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding TransferCarton.TcId}"
                       FontSize="14"
                       Foreground="#4B5563" />
        </StackPanel>

        <!-- Carton Information -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.Status}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Store"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.Store}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="ASN"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.AdvanceShippingNotice}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Transfer Order"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.TransferOrder}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Created By"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.CreatedBy}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Created On"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.CreatedOn, StringFormat=yyyy-MM-dd HH:mm}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Carton Contents -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Carton Contents (Derived from WMS Scan Events)"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding CartonContents}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Code"
                                            Binding="{Binding ItemCode}"
                                            Width="200" />
                        <DataGridTextColumn Header="Source Carton"
                                            Binding="{Binding SourceCartonId}"
                                            Width="160" />
                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Qty}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Packed By"
                                            Binding="{Binding PackedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Packed On"
                                            Binding="{Binding PackedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Summary + Actions -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalItems, StringFormat=Items: {0}}"
                           Margin="0,0,16,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#6B7280"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding UniqueItemCodes, StringFormat=Unique SKUs: {0}}"
                           Margin="0,0,16,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#6B7280"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalPieces, StringFormat=Total Pieces: {0}}"
                           Margin="0,0,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#1D4ED8"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Print Label"
                        Command="{Binding PrintLabelCommand}"
                        IsEnabled="{Binding CanPrintLabel}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Content="Print Out Slip"
                        Command="{Binding PrintOutSlipCommand}"
                        IsEnabled="{Binding CanPrintLabel}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Content="Dispatch"
                        Command="{Binding DispatchTransferCartonCommand}"
                        IsEnabled="{Binding CanDispatch}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Background="#F59E0B"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Content="Close"
                        Width="80"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

