<Window x:Class="Wms.Desktop.TransferCartonDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Wms.Desktop.Converters"
        mc:Ignorable="d"
        Title="Transfer Carton Details"
        Height="700" Width="960"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Background="#F3F4F6" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Transfer Carton Details"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding TransferCarton.TcId}"
                       FontSize="14"
                       Foreground="#4B5563" />
        </StackPanel>

        <!-- Carton Information -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.Status}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Store"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.Store}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="ASN"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.AdvanceShippingNotice}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Transfer Order"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.TransferOrder}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Created By"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.CreatedBy}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Created On"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding TransferCarton.CreatedOn, StringFormat=yyyy-MM-dd HH:mm}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>
                <!-- Purchase Receipt and Stock Entry (ERPNext) -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <TextBlock Text="Purchase Receipt"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding PurchaseReceiptDisplay, TargetNullValue='—'}"
                               FontSize="14"
                               Foreground="#059669" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <TextBlock Text="Stock Entry"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding WarehouseTransferDisplay, TargetNullValue='—'}"
                               FontSize="14"
                               Foreground="#1D4ED8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Carton Contents -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Carton Contents (Derived from WMS Scan Events)"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding CartonContents}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Code"
                                            Binding="{Binding ItemCode}"
                                            Width="200" />
                        <DataGridTextColumn Header="Sort box (Box ID)"
                                            Binding="{Binding BoxIdForDisplay}"
                                            Width="200" />
                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Qty}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Packed By"
                                            Binding="{Binding PackedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Packed On"
                                            Binding="{Binding PackedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Summary + Actions (two rows: stats never overlap action buttons) -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10">
                <TextBlock Text="{Binding TotalItems, StringFormat=Items: {0}}"
                           Margin="0,0,16,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#6B7280"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding UniqueItemCodes, StringFormat=Unique SKUs: {0}}"
                           Margin="0,0,16,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#6B7280"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalPieces, StringFormat=Total Pieces: {0}}"
                           Margin="0,0,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#1D4ED8"
                           VerticalAlignment="Center" />
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       Orientation="Horizontal"
                       HorizontalAlignment="Right">
                <Button Content="Generate Stock Entry"
                        Command="{Binding GenerateStockEntryCommand}"
                        IsEnabled="{Binding CanGenerateStockEntry}"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#059669"
                        Foreground="White"
                        BorderThickness="0"
                        ToolTip="Create Warehouse Transfer (Stock Entry) in ERPNext. Enabled when PR is submitted." />
                <Button Content="Print Label"
                        Command="{Binding PrintLabelCommand}"
                        IsEnabled="{Binding CanPrintLabel}"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Content="Get Purchase Receipt"
                        Command="{Binding GetPurchaseReceiptCommand}"
                        IsEnabled="{Binding CanGetPurchaseReceipt}"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#8B5CF6"
                        Foreground="White"
                        BorderThickness="0"
                        ToolTip="Fetch PR status from ERPNext and update this transfer carton. Disabled after a Stock Entry is linked (workflow is past PR refresh)." />
                <Button Content="Print Out Slip"
                        Command="{Binding PrintOutSlipCommand}"
                        IsEnabled="{Binding CanPrintOutSlip}"
                        Visibility="{Binding CanPrintOutSlip, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        ToolTip="Available after Stock Entry is created for this transfer carton" />
                <Button Content="Print packing list"
                        Command="{Binding PrintPackingListCommand}"
                        IsEnabled="{Binding CanPrintPackingList}"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#1D4ED8"
                        Foreground="White"
                        BorderThickness="0"
                        ToolTip="Print this transfer carton only — same lines as Carton Contents below (not the multi-carton sort-box list)." />
                <Button Content="Dispatch"
                        Command="{Binding DispatchTransferCartonCommand}"
                        IsEnabled="{Binding CanDispatch}"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#F59E0B"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Content="Close"
                        Width="80"
                        Margin="0,0,0,8"
                        IsCancel="True" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>

