<Window x:Class="Wms.Desktop.WmsTransactionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wms.Desktop.ViewModels"
        xmlns:helpers="clr-namespace:Wms.Desktop.Helpers"
        xmlns:models="clr-namespace:Wms.Desktop.Models"
        mc:Ignorable="d"
        Title="WMS Transaction Details"
        Height="720" Width="1200"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <helpers:OperationTypeToVisibilityConverter x:Key="OpVis"/>

        <!-- Operation-specific templates -->
        <DataTemplate x:Key="ReceivingTemplate" DataType="{x:Type models:WmsTransaction}">
            <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E7EB" Background="White">
                <StackPanel>
                    <TextBlock Text="Receiving Options" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="#111827"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Receiving Dock" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <TextBox Width="220" Text="{Binding ReceivingDock, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                            <TextBlock Text="Require QC" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <CheckBox IsChecked="{Binding RequireQC}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="#6B7280" FontSize="11"
                               Text="Tip: For Receiving, Source Bin is usually Dock and ContainerId (Carton) is important."/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PutawayTemplate" DataType="{x:Type models:WmsTransaction}">
            <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E7EB" Background="White">
                <StackPanel>
                    <TextBlock Text="Putaway Options" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="#111827"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Putaway Strategy" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <ComboBox Width="260" SelectedItem="{Binding PutawayStrategy}" Padding="6">
                                <ComboBoxItem Content="Nearest Empty Bin"/>
                                <ComboBoxItem Content="FIFO Zone"/>
                                <ComboBoxItem Content="Fixed Bin"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                            <TextBlock Text="Suggest Bins" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <CheckBox IsChecked="{Binding SuggestBins}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="#6B7280" FontSize="11"
                               Text="Tip: For Putaway, Target Bin becomes mandatory and can be auto-suggested."/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PickingTemplate" DataType="{x:Type models:WmsTransaction}">
            <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E7EB" Background="White">
                <StackPanel>
                    <TextBlock Text="Picking Options" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="#111827"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Picking Wave" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <TextBox Width="220" Text="{Binding PickingWave}" Padding="6"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Pick Route" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <TextBox Width="220" Text="{Binding PickRoute}" Padding="6"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="#6B7280" FontSize="11"
                               Text="Tip: For Picking, Source Bin is critical; ContainerId may be optional depending on flow."/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CycleCountTemplate" DataType="{x:Type models:WmsTransaction}">
            <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E7EB" Background="White">
                <StackPanel>
                    <TextBlock Text="Cycle Count Options" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="#111827"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Count Zone" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <TextBox Width="220" Text="{Binding CycleCountZone}" Padding="6"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Margin="20,0,0,0">
                            <TextBlock Text="Freeze Stock During Count" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <CheckBox IsChecked="{Binding FreezeStockDuringCount}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="#6B7280" FontSize="11"
                               Text="Tip: For Cycle Count, ActualQtyCounted + Discrepancy columns should appear."/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DefaultTemplate" DataType="{x:Type models:WmsTransaction}">
            <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E7EB" Background="White">
                <TextBlock Text="No extra options for this Operation Type." Foreground="#6B7280"/>
            </Border>
        </DataTemplate>

        <helpers:OperationTemplateSelector x:Key="OpTemplateSelector"
                                           ReceivingTemplate="{StaticResource ReceivingTemplate}"
                                           PutawayTemplate="{StaticResource PutawayTemplate}"
                                           PickingTemplate="{StaticResource PickingTemplate}"
                                           CycleCountTemplate="{StaticResource CycleCountTemplate}"
                                           DefaultTemplate="{StaticResource DefaultTemplate}"/>
    </Window.Resources>

    <Grid Background="#F3F4F6" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top action buttons (demo) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Receiving" Margin="0,0,8,0" Padding="10,6"
                    Command="{Binding SwitchToReceivingCommand}"/>
            <Button Content="Putaway" Margin="0,0,8,0" Padding="10,6"
                    Command="{Binding SwitchToPutawayCommand}"/>
            <Button Content="Picking" Margin="0,0,8,0" Padding="10,6"
                    Command="{Binding SwitchToPickingCommand}"/>
            <Button Content="Cycle Count" Padding="10,6"
                    Command="{Binding SwitchToCycleCountCommand}"/>
        </StackPanel>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="4,0,4,8">
            <TextBlock Text="WMS Transaction"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding Transaction.Title}"
                       FontSize="14"
                       Foreground="#4B5563" />
        </StackPanel>

        <!-- Header fields (common) -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Col 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Operation Type"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Transaction.OperationType}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Transaction Date"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Transaction.TransactionDate, StringFormat=g}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Assigned To"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Transaction.AssignedTo}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <!-- Col 2 -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,4">
                    <TextBlock Text="Source Warehouse"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Transaction.SourceWarehouse}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,4">
                    <TextBlock Text="Target Warehouse"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Transaction.TargetWarehouse}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,8,0">
                    <TextBlock Text="Reference Doc"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock FontSize="14" Foreground="#111827">
                        <Run Text="{Binding Transaction.ReferenceDocType}"/>
                        <Run Text=" - "/>
                        <Run Text="{Binding Transaction.ReferenceDoc}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Col 3 -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,4">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Transaction.Status}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,4">
                    <TextBlock Text="Transaction Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <ComboBox SelectedItem="{Binding Transaction.TransactionStatus, UpdateSourceTrigger=PropertyChanged}"
                              FontSize="14"
                              Padding="4"
                              Margin="0,2,0,0">
                        <ComboBoxItem Content="Draft" />
                        <ComboBoxItem Content="In Planning" />
                        <ComboBoxItem Content="In Progress" />
                        <ComboBoxItem Content="Partial" />
                        <ComboBoxItem Content="Completed" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="Completion %"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <ProgressBar Height="18" Minimum="0" Maximum="100"
                                 Value="{Binding Transaction.CompletionProgress}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Transaction.CompletionProgress, StringFormat={}{0}%}" 
                               HorizontalAlignment="Right" FontSize="12" Foreground="#111827"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Operation-specific panel (swaps layout) -->
        <ContentControl Grid.Row="3" Margin="0,0,0,8"
                        Content="{Binding Transaction}"
                        ContentTemplateSelector="{StaticResource OpTemplateSelector}"/>

        <!-- Item details grid -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Item Details"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Transaction.Details}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Code"
                                            Binding="{Binding ItemCode}"
                                            Width="160"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Item Name"
                                            Binding="{Binding ItemName}"
                                            Width="*"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Qty}"
                                            Width="80"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="UOM"
                                            Binding="{Binding Uom}"
                                            Width="80"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Container"
                                            Binding="{Binding ContainerId}"
                                            Width="140"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Source Bin"
                                            Binding="{Binding SourceBin}"
                                            Width="140"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Target Bin"
                                            Binding="{Binding TargetBin}"
                                            Width="140" />
                        <!-- Cycle Count only columns -->
                        <DataGridTextColumn Header="Actual Count"
                                            Binding="{Binding ActualQtyCounted}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="{Binding DataContext.Transaction.OperationType,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource OpVis},
                                                    ConverterParameter=CycleCount}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Discrepancy"
                                            Binding="{Binding Discrepancy}"
                                            IsReadOnly="True"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="{Binding DataContext.Transaction.OperationType,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource OpVis},
                                                    ConverterParameter=CycleCount}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridComboBoxColumn Header="Assignment Status"
                                                SelectedItemBinding="{Binding AssignmentStatus}"
                                                Width="140">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource">
                                        <Setter.Value>
                                            <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                <sys:String>Pending</sys:String>
                                                <sys:String>Assigned</sys:String>
                                                <sys:String>In Progress</sys:String>
                                                <sys:String>Done</sys:String>
                                                <sys:String>Cancelled</sys:String>
                                            </x:Array>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource">
                                        <Setter.Value>
                                            <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                <sys:String>Pending</sys:String>
                                                <sys:String>Assigned</sys:String>
                                                <sys:String>In Progress</sys:String>
                                                <sys:String>Done</sys:String>
                                                <sys:String>Cancelled</sys:String>
                                            </x:Array>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn Header="Assigned Operator"
                                            Binding="{Binding AssignedOperator}"
                                            Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Concurrent users -->
        <Border Grid.Row="5"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Concurrent Users"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Transaction.ConcurrentUsers}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User"
                                            Binding="{Binding User}"
                                            Width="160" />
                        <DataGridTextColumn Header="Assigned Items"
                                            Binding="{Binding AssignedItemsCount}"
                                            Width="120" />
                        <DataGridTextColumn Header="Completed Items"
                                            Binding="{Binding CompletedItemsCount}"
                                            Width="130" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Totals + Action Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    VerticalAlignment="Bottom">
            <TextBlock Text="{Binding TotalLines, StringFormat=Lines: {0}}"
                       Margin="0,0,16,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalQty, StringFormat=Total Qty: {0}}"
                       Margin="0,0,24,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <Button Content="Save Changes"
                    Width="120"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Command="{Binding SaveTransactionCommand}"
                    Background="#10B981"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
            <Button Content="Assign Selected"
                    Width="120"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Command="{Binding AssignSelectedItemsCommand}"
                    Background="#3B82F6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
            <Button Content="Mark Selected Done"
                    Width="140"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Command="{Binding MarkSelectedDoneCommand}"
                    Background="#8B5CF6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
            <Button Content="Close"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
