<Window x:Class="Wms.Desktop.AsnDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ASN Details"
        Height="600" Width="1800"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F3F4F6" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Advance Shipping Notice"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#111827" />
            <TextBlock Text="{Binding Asn.Title}"
                       FontSize="14"
                       Foreground="#4B5563" />
        </StackPanel>

        <!-- Header fields -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Supplier"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Asn.Supplier}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Purchase Order"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Asn.PurchaseOrder}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,4">
                    <TextBlock Text="Shipment Date"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Asn.ShipmentDate, StringFormat=d}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Expected Arrival"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Asn.ExpectedArrivalDate, StringFormat=d}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,4">
                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Asn.Status}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Shipment Type"
                               FontWeight="SemiBold"
                               Foreground="#6B7280" />
                    <TextBlock Text="{Binding Asn.ShipmentType}"
                               FontSize="14"
                               Foreground="#111827" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Carton / Item lines -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="ASN Item Details"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Asn.Details}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <!-- Item Information -->
                        <DataGridTextColumn Header="Item Code"
                                            Binding="{Binding ItemCode}"
                                            Width="150" />
                        <DataGridTextColumn Header="PO Item Reference"
                                            Binding="{Binding PoItemReference}"
                                            Width="140" />
                        <DataGridTextColumn Header="Shipped Qty"
                                            Binding="{Binding ShippedQty, StringFormat=N2}"
                                            Width="100" />
                        <DataGridTextColumn Header="Recvd Qty"
                                            Binding="{Binding ReceivedQty, StringFormat=N2}"
                                            Width="100" />
                        <DataGridTextColumn Header="Carton ID"
                                            Binding="{Binding CartonId}"
                                            Width="140" />
                        <DataGridTextColumn Header="Carton Status"
                                            Binding="{Binding CartonAssignedStatus}"
                                            Width="120" />
                        
                        <!-- Receiving Carton Information -->
                        <DataGridTextColumn Header="Inbound Session"
                                            Binding="{Binding InboundSession}"
                                            Width="140" />
                        <DataGridTextColumn Header="Receiving Status"
                                            Binding="{Binding ReceivingStatus}"
                                            Width="130" />
                        <DataGridTextColumn Header="Opened By"
                                            Binding="{Binding OpenedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Opened On"
                                            Binding="{Binding OpenedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="150" />
                        <DataGridTextColumn Header="Locked By"
                                            Binding="{Binding LockedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Locked On"
                                            Binding="{Binding LockedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="150" />
                        <DataGridTextColumn Header="Received By"
                                            Binding="{Binding ReceivedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Received On"
                                            Binding="{Binding ReceivedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="150" />
                        <DataGridTextColumn Header="Verified By"
                                            Binding="{Binding VerifiedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Verified On"
                                            Binding="{Binding VerifiedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="150" />
                        <DataGridTextColumn Header="Updated On"
                                            Binding="{Binding UpdatedOn, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="150" />
                        <DataGridTextColumn Header="Remarks"
                                            Binding="{Binding Remarks}"
                                            Width="200" />
                        <DataGridTextColumn Header="Created At"
                                            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Totals + Close -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding TotalQtyExpected, StringFormat=Total Shipped Qty: {0}}"
                       Margin="0,0,24,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#1D4ED8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalQtyReceived, StringFormat=Total Received: {0}}"
                       Margin="0,0,24,0"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#059669"
                       VerticalAlignment="Center" />
            <Button Content="Close"
                    Width="80"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>


