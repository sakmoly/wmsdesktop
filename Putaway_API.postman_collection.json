                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock-ledger/{{item_code}}/{{warehouse}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-ledger", "{{item_code}}", "{{warehouse}}"]
            }
          }
        },
        {
          "name": "Get Stock Ledger by Location (with Carton)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock/ledger?bin_location={{location_id}}&carton_id={{box_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "ledger"],
              "query": [
                {
                  "key": "bin_location",
                  "value": "{{location_id}}"
                },
                {
                  "key": "carton_id",
                  "value": "{{box_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Transaction History Verification",
      "item": [
        {
          "name": "Get All Transaction History",
          "request": {
            "method": "GET",
