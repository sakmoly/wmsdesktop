{
  "info": {
    "name": "Putaway API - Complete Testing",
    "description": "Complete Postman collection for testing Putaway APIs with Stock, Ledger, and History verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set('token', jsonData.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Putaway APIs",
      "item": [
        {
          "name": "Get Putaway Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/putaway/tasks?status=Open&source_type=ASN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "putaway", "tasks"],
              "query": [
                {
                  "key": "status",
                  "value": "Open"
                },
                {
                  "key": "source_type",
                  "value": "ASN"
                }
              ]
            }
          }
        },
        {
          "name": "Scan Transfer Carton (ASN - box_id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"box_id\": \"{{box_id}}\",\n  \"location_id\": \"{{location_id}}\",\n  \"user_id\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/putaway/scan-transfer-carton",
              "host": ["{{baseUrl}}"],
              "path": ["api", "putaway", "scan-transfer-carton"]
            }
          }
        },
        {
          "name": "Scan Transfer Carton (Transfer In - tc_id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tc_id\": \"{{tc_id}}\",\n  \"location_id\": \"{{location_id}}\",\n  \"user_id\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/putaway/scan-transfer-carton",
              "host": ["{{baseUrl}}"],
              "path": ["api", "putaway", "scan-transfer-carton"]
            }
          }
        },
        {
          "name": "Complete Putaway (Header Location)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.putaway_task) {",
                  "        pm.environment.set('putaway_task', jsonData.data.putaway_task);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"putaway_task\": \"{{putaway_task}}\",\n  \"location_id\": \"{{location_id}}\",\n  \"performed_by\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/putaway/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "putaway", "complete"]
            }
          }
        },
        {
          "name": "Complete Putaway (With box_id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"box_id\": \"{{box_id}}\",\n  \"location_id\": \"{{location_id}}\",\n  \"performed_by\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/putaway/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "putaway", "complete"]
            }
          }
        },
        {
          "name": "Complete Putaway (With Items Array)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"putaway_task\": \"{{putaway_task}}\",\n  \"performed_by\": \"{{user_id}}\",\n  \"items\": [\n    {\n      \"item_code\": \"{{item_code}}\",\n      \"qty\": 5.00,\n      \"location_id\": \"{{location_id}}\",\n      \"carton_id\": \"{{box_id}}\",\n      \"completed\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/putaway/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "putaway", "complete"]
            }
          }
        },
        {
          "name": "Get Remaining Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/putaway/remaining-items?asn=ASN-365425473",
              "host": ["{{baseUrl}}"],
              "path": ["api", "putaway", "remaining-items"],
              "query": [
                {
                  "key": "asn",
                  "value": "ASN-365425473"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Stock Ledger Verification",
      "item": [
        {
          "name": "Get All Stock Ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock-ledger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-ledger"]
            }
          }
        },
        {
          "name": "Get Stock Ledger by Item and Location",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock-ledger?item_code={{item_code}}&bin_location={{location_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-ledger"],
              "query": [
                {
                  "key": "item_code",
                  "value": "{{item_code}}"
                },
                {
                  "key": "bin_location",
                  "value": "{{location_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Stock Ledger by Item and Warehouse",
          "request": {
            "method": "GET",
            "header": [
