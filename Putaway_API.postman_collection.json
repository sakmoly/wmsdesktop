            "url": {
              "raw": "{{baseUrl}}/api/transaction-history?from_date=2026-01-19&to_date=2026-01-20&transaction_type=Putaway",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transaction-history"],
              "query": [
                {
                  "key": "from_date",
                  "value": "2026-01-19"
                },
                {
                  "key": "to_date",
                  "value": "2026-01-20"
                },
                {
                  "key": "transaction_type",
                  "value": "Putaway"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Complete Test Workflow",
      "item": [
        {
          "name": "Workflow: ASN Putaway Complete Flow",
          "item": [
            {
              "name": "Step 1: Get Open Tasks",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/putaway/tasks?status=Open",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "putaway", "tasks"],
                  "query": [
                    {
                      "key": "status",
                      "value": "Open"
                    }
                  ]
                }
              }
            },
            {
              "name": "Step 2: Scan Box and Location",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"box_id\": \"{{box_id}}\",\n  \"location_id\": \"{{location_id}}\",\n  \"user_id\": \"{{user_id}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/putaway/scan-transfer-carton",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "putaway", "scan-transfer-carton"]
                }
              }
            },
            {
              "name": "Step 3: Complete Putaway",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"putaway_task\": \"{{putaway_task}}\",\n  \"location_id\": \"{{location_id}}\",\n  \"performed_by\": \"{{user_id}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/putaway/complete",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "putaway", "complete"]
                }
              }
            },
            {
              "name": "Step 4: Verify Stock Ledger",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/stock-ledger?item_code={{item_code}}&bin_location={{location_id}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "stock-ledger"],
                  "query": [
                    {
                      "key": "item_code",
                      "value": "{{item_code}}"
                    },
                    {
                      "key": "bin_location",
                      "value": "{{location_id}}"
                    }
                  ]
                }
              }
            },
            {
              "name": "Step 5: Verify Transaction History",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/transaction-history?reference_doc={{putaway_task}}&transaction_type=Putaway",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "transaction-history"],
                  "query": [
                    {
                      "key": "reference_doc",
                      "value": "{{putaway_task}}"
                    },
                    {
                      "key": "transaction_type",
                      "value": "Putaway"
                    }
                  ]
                }
              }
            },
            {
              "name": "Step 6: Verify Task Status",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/putaway/tasks?status=Completed",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "putaway", "tasks"],
                  "query": [
                    {
                      "key": "status",
                      "value": "Completed"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
